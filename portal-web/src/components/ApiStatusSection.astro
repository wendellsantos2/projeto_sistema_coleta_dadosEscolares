---
---

<section id="api" class="api-section">
  <div class="container">
    <div class="section-header">
      <div class="badge badge-live">
        <span class="badge-dot"></span>
        <span>Infraestrutura em Nuvem</span>
      </div>
      <h2 class="section-title">Backend Robusto & API RESTful</h2>
      <p class="section-desc">
        Arquitetura conteinerizada em Docker na AWS com alta disponibilidade, banco de dados PostgreSQL relacional e documentação interativa Swagger para integrações.
      </p>
    </div>

    <div class="api-grid">
      <!-- Live Status Card -->
      <div class="status-card glass-card">
        <div class="status-header">
          <div class="status-title-box">
            <span class="status-label">Monitoramento em Tempo Real</span>
            <h3 class="status-heading">Instância AWS EC2 Produção</h3>
          </div>
          <div id="live-indicator" class="live-pill online">
            <span class="pulse-point"></span>
            <span id="live-text">Conectado (AWS)</span>
          </div>
        </div>

        <div class="service-list">
          <div class="service-row">
            <div class="service-info">
              <span class="service-name">Web Admin (Frontend)</span>
              <span class="service-tech">Nginx 1.27 • React 19 SPA</span>
            </div>
            <span class="service-port">Porta :80</span>
          </div>

          <div class="service-row">
            <div class="service-info">
              <span class="service-name">WebApi (.NET 9.0)</span>
              <span class="service-tech">ASP.NET Core • JWT Auth • Swagger</span>
            </div>
            <span class="service-port">Porta :8080</span>
          </div>

          <div class="service-row">
            <div class="service-info">
              <span class="service-name">Banco de Dados Relacional</span>
              <span class="service-tech">PostgreSQL 15 Alpine</span>
            </div>
            <span class="service-port">Porta :5432</span>
          </div>
        </div>

        <div class="swagger-action-box">
          <div class="swagger-text">
            <h4>Documentação OpenAPI / Swagger</h4>
            <p>Explore schemas de dados, endpoints de autenticação, famílias, alunos e registros.</p>
          </div>
          <a href="http://18.219.242.45:8080/swagger" target="_blank" rel="noopener noreferrer" class="btn-primary btn-swagger">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Abrir Swagger UI
          </a>
        </div>
      </div>

      <!-- Quick Curl / Dev Card -->
      <div class="dev-card glass-card">
        <h3 class="dev-card-title">Endpoint Base da API</h3>
        <p class="dev-card-desc">Para integrar outros clientes ou testar com ferramentas como cURL e Postman:</p>
        
        <div class="code-box">
          <span class="code-label">URL Base:</span>
          <code>http://18.219.242.45/api</code>
        </div>

        <div class="code-box">
          <span class="code-label">Exemplo cURL (Healthcheck / Teste):</span>
          <code>curl -i http://18.219.242.45/api/auth/login</code>
        </div>

        <div class="tech-tags">
          <span class="tag">Docker Compose</span>
          <span class="tag">PostgreSQL 15</span>
          <span class="tag">ASP.NET Core 9</span>
          <span class="tag">AWS t3.micro</span>
          <span class="tag">Vercel Deploy</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .api-section {
    padding: 70px 0 90px;
  }

  .api-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
  }

  .status-card, .dev-card {
    padding: 36px;
  }

  .status-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
  }

  .status-label {
    font-size: 0.8rem;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
  }

  .status-heading {
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin-top: 4px;
  }

  .live-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .pulse-point {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
  }

  .service-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 30px;
  }

  .service-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.025);
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .service-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .service-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f1f5f9;
  }

  .service-tech {
    font-size: 0.8rem;
    color: var(--text-subtle);
  }

  .service-port {
    font-family: monospace;
    font-size: 0.85rem;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .swagger-action-box {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(56, 189, 248, 0.08) 100%);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .swagger-text h4 {
    font-size: 1rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 4px;
  }

  .swagger-text p {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .btn-swagger {
    flex-shrink: 0;
    padding: 10px 20px;
    font-size: 0.9rem;
  }

  /* Dev card */
  .dev-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .dev-card-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .code-box {
    background: #060911;
    border: 1px solid var(--border-color);
    padding: 14px 16px;
    border-radius: 10px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .code-label {
    font-size: 0.75rem;
    color: var(--text-subtle);
    font-weight: 600;
    text-transform: uppercase;
  }

  .code-box code {
    font-family: 'Fira Code', monospace, Consolas;
    font-size: 0.88rem;
    color: #34d399;
    word-break: break-all;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tag {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
  }

  @media (max-width: 900px) {
    .api-grid {
      grid-template-columns: 1fr;
    }
    .swagger-action-box {
      flex-direction: column;
      align-items: flex-start;
    }
    .btn-swagger {
      width: 100%;
    }
  }
</style>
