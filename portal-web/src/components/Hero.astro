---
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-badge-wrapper">
      <div class="badge badge-live">
        <span class="badge-dot"></span>
        <span>Versão 1.0 em Produção na AWS EC2</span>
      </div>
    </div>

    <h1 class="hero-title">
      Ecossistema Integrado de <br />
      <span class="gradient-text">Coleta e Gestão Escolar</span>
    </h1>

    <p class="hero-subtitle">
      Plataforma completa para cadastramento socioeconômico de famílias e alunos em campo. 
      Sincronização offline-first inteligente, painel analítico administrativo e infraestrutura em nuvem de alta confiabilidade.
    </p>

    <div class="hero-actions">
      <a href="http://18.219.242.45" target="_blank" rel="noopener noreferrer" class="btn-primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="14" x="2" y="3" rx="2"></rect>
          <line x1="8" x2="16" y1="21" y2="21"></line>
          <line x1="12" x2="12" y1="17" y2="21"></line>
        </svg>
        Acessar Painel Web
      </a>
      
      <a href="#app" class="btn-secondary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        Baixar App Mobile (.APK)
      </a>
    </div>

    <div class="hero-metrics-grid">
      <div class="metric-card glass-card">
        <span class="metric-number">Offline-First</span>
        <span class="metric-label">App Flutter com SQLite e sincronização automática</span>
      </div>
      <div class="metric-card glass-card">
        <span class="metric-number">.NET 9 + Postgres</span>
        <span class="metric-label">Backend veloz rodando em Docker na AWS</span>
      </div>
      <div class="metric-card glass-card">
        <span class="metric-number">Vite + React</span>
        <span class="metric-label">Dashboard administrativo com métricas e relatórios</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 80px 0 60px;
    text-align: center;
    position: relative;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge-wrapper {
    margin-bottom: 24px;
  }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
    max-width: 900px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #10b981 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 720px;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 60px;
  }

  .hero-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    max-width: 960px;
  }

  .metric-card {
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }

  .metric-number {
    font-size: 1.25rem;
    font-weight: 700;
    color: #38bdf8;
  }

  .metric-label {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .hero-metrics-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
