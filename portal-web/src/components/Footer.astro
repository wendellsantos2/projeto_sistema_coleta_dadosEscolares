---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-left">
      <span class="footer-brand">Sistema de Coleta de Dados Escolares</span>
      <p class="footer-desc">Solução integrada para censo e cadastramento escolar em tempo real com apoio à decisão pública.</p>
    </div>

    <div class="footer-right">
      <div class="footer-links">
        <a href="http://18.219.242.45" target="_blank" rel="noopener noreferrer">Painel Web Admin</a>
        <a href="/downloads/app-release.apk">Baixar App (.apk)</a>
        <a href="http://18.219.242.45:8080/swagger" target="_blank" rel="noopener noreferrer">Swagger API</a>
        <a href="https://github.com/wendellsantos2/projeto_sistema_coleta_dadosEscolares" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <span class="copyright">© {currentYear} • Construído com Astro & Vercel</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    background: #05080e;
    padding: 48px 0;
    margin-top: 40px;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-brand {
    font-size: 1.05rem;
    font-weight: 700;
    color: #f1f5f9;
  }

  .footer-desc {
    font-size: 0.85rem;
    color: var(--text-subtle);
    max-width: 440px;
    margin-top: 6px;
    line-height: 1.5;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #10b981;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--text-subtle);
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-right {
      align-items: flex-start;
    }
    .footer-links {
      flex-wrap: wrap;
      gap: 12px;
    }
  }
</style>
