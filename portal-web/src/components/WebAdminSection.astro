---
---

<section id="admin" class="admin-section">
  <div class="container">
    <div class="admin-card glass-card">
      <div class="admin-content">
        <div class="badge badge-live">
          <span class="badge-dot"></span>
          <span>Web Admin • React + Vite</span>
        </div>

        <h2 class="admin-title">Painel Administrativo para Gestão e Decisão</h2>
        <p class="admin-desc">
          Ambiente centralizado para secretarias de educação e gestores públicos. Visualize métricas socioeconômicas em tempo real, gerencie cadastros enviados pelos agentes e exporte relatórios consolidados.
        </p>

        <div class="admin-features-list">
          <div class="feature-bullet">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Monitoramento em tempo real de coletas recebidas da nuvem</span>
          </div>
          <div class="feature-bullet">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Filtros avançados por escola, série, faixa de renda e localidade</span>
          </div>
          <div class="feature-bullet">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Autenticação corporativa com JWT e perfis de acesso seguro</span>
          </div>
        </div>

        <div class="admin-actions">
          <a href="http://18.219.242.45" target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" x2="21" y1="14" y2="3"></line>
            </svg>
            Abrir Painel Administrativo
          </a>
          <span class="host-info">Hospedado na AWS: <code>http://18.219.242.45</code></span>
        </div>
      </div>

      <!-- Preview Mockup do Painel -->
      <div class="admin-mockup-wrapper">
        <div class="browser-window">
          <div class="window-header">
            <div class="window-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="window-address">http://18.219.242.45/dashboard</div>
          </div>
          <div class="window-body">
            <div class="mock-stats-row">
              <div class="mock-stat-box">
                <span class="mock-val">1.428</span>
                <span class="mock-lbl">Famílias Cadastradas</span>
              </div>
              <div class="mock-stat-box">
                <span class="mock-val">2.890</span>
                <span class="mock-lbl">Alunos Atendidos</span>
              </div>
              <div class="mock-stat-box highlight">
                <span class="mock-val">100%</span>
                <span class="mock-lbl">Sincronizados</span>
              </div>
            </div>
            <div class="mock-chart-placeholder">
              <div class="mock-bar" style="height: 45%;"></div>
              <div class="mock-bar" style="height: 70%;"></div>
              <div class="mock-bar" style="height: 55%;"></div>
              <div class="mock-bar active" style="height: 90%;"></div>
              <div class="mock-bar" style="height: 65%;"></div>
              <div class="mock-bar" style="height: 80%;"></div>
            </div>
            <div class="mock-table-lines">
              <div class="mock-line"></div>
              <div class="mock-line"></div>
              <div class="mock-line short"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .admin-section {
    padding: 60px 0;
  }

  .admin-card {
    padding: 48px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    border-color: rgba(56, 189, 248, 0.2);
  }

  .admin-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .admin-title {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .admin-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .admin-features-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 8px 0;
  }

  .feature-bullet {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.95rem;
    color: #e2e8f0;
  }

  .admin-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 10px;
  }

  .host-info {
    font-size: 0.82rem;
    color: var(--text-subtle);
  }

  .host-info code {
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 8px;
    border-radius: 4px;
    color: #38bdf8;
    font-family: monospace;
  }

  /* Browser Mockup */
  .browser-window {
    background: #0b1120;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
  }

  .window-header {
    background: #0f172a;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #ef4444; }
  .dot.yellow { background: #f59e0b; }
  .dot.green { background: #10b981; }

  .window-address {
    background: rgba(0, 0, 0, 0.3);
    padding: 4px 14px;
    border-radius: 6px;
    font-size: 0.78rem;
    color: #94a3b8;
    font-family: monospace;
    flex: 1;
  }

  .window-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .mock-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .mock-stat-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 14px 10px;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  .mock-stat-box.highlight {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.06);
  }

  .mock-val {
    font-size: 1.15rem;
    font-weight: 800;
    color: #fff;
  }

  .mock-stat-box.highlight .mock-val {
    color: #34d399;
  }

  .mock-lbl {
    font-size: 0.68rem;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .mock-chart-placeholder {
    height: 120px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 10px;
    padding: 16px 20px 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    gap: 8px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mock-bar {
    width: 20px;
    background: rgba(56, 189, 248, 0.3);
    border-radius: 4px 4px 0 0;
    transition: height 0.3s ease;
  }

  .mock-bar.active {
    background: linear-gradient(180deg, #10b981 0%, #059669 100%);
  }

  .mock-table-lines {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mock-line {
    height: 8px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    width: 100%;
  }

  .mock-line.short {
    width: 65%;
  }

  @media (max-width: 900px) {
    .admin-card {
      grid-template-columns: 1fr;
      padding: 32px 24px;
    }
  }
</style>
